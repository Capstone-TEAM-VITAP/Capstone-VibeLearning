// use prisma-next

types {
  Uuid = Uuid
}

model User {
  id          Uuid     @id @default(uuid())
  clerkUserId String   @unique
  email       String?
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  projects     Project[]
  repositories Repository[]

  @@map("user")
}

model Project {
  id          Uuid     @id @default(uuid())
  name        String
  description String?
  userId      Uuid

  user User @relation(fields: [userId], references: [id])

  repositories Repository[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([userId])
  @@map("project")
}

model Repository {
  id            Uuid    @id @default(uuid())
  userId        Uuid
  projectId     Uuid?
  repoUrl       String
  owner         String
  name          String
  defaultBranch String  @default("main")
  lastSyncSha   String?

  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  snapshots RepoSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([userId, repoUrl])
  @@index([userId])
  @@index([projectId])
  @@map("repository")
}

model RepoSnapshot {
  id           Uuid     @id @default(uuid())
  repositoryId Uuid
  commitSha    String
  baseSha      String?
  message      String?
  authorName   String?
  committedAt  DateTime?
  fileCount    Int      @default(0)
  additions    Int      @default(0)
  deletions    Int      @default(0)

  repository Repository @relation(fields: [repositoryId], references: [id])

  job AnalysisJob?

  createdAt DateTime @default(now())

  @@unique([repositoryId, commitSha])
  @@index([repositoryId])
  @@map("repo_snapshot")
}

model AnalysisJob {
  id         Uuid   @id @default(uuid())
  snapshotId Uuid   @unique
  status     String @default("pending")
  attempts   Int    @default(0)
  error      String?
  resultJson String?

  snapshot RepoSnapshot @relation(fields: [snapshotId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([status])
  @@map("analysis_job")
}